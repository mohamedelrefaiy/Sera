__pycache__/
*.pyc
.ruff_cache/
.DS_Store
.venv/
*.egg-info/
# Packaging byproducts from `python -m build` / wheel builds — regenerable, never committed.
build/
dist/
*.whl
.claude
.gstack/
.agents

# Chat run logs (replay spine) — reproducible from a live run, never published.
runs/

# Persisted chat sessions (runtime data written by api/sessions.py) — per-user,
# never published. The code that writes them IS committed; their output is not.
data/sessions/

# Local pre-redesign snapshots of the frontend — safety copies, kept out of git.
*.bak.html

# Concord pipeline: the 16.8 GB source h5ad (only present if 00_download.py --download
# was run) is huge and reproducible from public S3 — never commit it. The small extracted
# parquet under data/artifacts/ IS the served deliverable and is intentionally NOT ignored.
data/raw/
*.h5ad
*.h5mu

# Documents and working notes — kept local, not published. The public repo is
# code only: application/ (the app) + LICENSE + README.
docs/
memory/
prototype/
CLAUDE.md
skills-lock.json
